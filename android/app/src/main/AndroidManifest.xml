<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- RetroAchievements login and unlocks (HTTPS). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:isGame="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:resizeableActivity="true"
        android:theme="@style/GbaTheme">
        <meta-data android:name="gbarecomp.title" android:value="${gbaTitle}" />
        <meta-data android:name="gbarecomp.rom_label" android:value="${gbaRomLabel}" />
        <meta-data android:name="gbarecomp.rom_sha1" android:value="${gbaRomSha1}" />
        <meta-data android:name="gbarecomp.rom_patch_source_sha1" android:value="${gbaRomPatchSourceSha1}" />
        <meta-data android:name="gbarecomp.rom_size" android:value="${gbaRomSize}" />
        <meta-data android:name="gbarecomp.rom_file" android:value="${gbaRomFile}" />
        <meta-data android:name="gbarecomp.bios_required" android:value="${gbaBiosRequired}" />
        <meta-data android:name="gbarecomp.bios_sha1" android:value="${gbaBiosSha1}" />
        <meta-data android:name="gbarecomp.orientation" android:value="${gbaOrientation}" />
        <meta-data android:name="gbarecomp.payload_version" android:value="${gbaPayloadVersion}" />
        <meta-data android:name="gbarecomp.setup_note" android:value="${gbaSetupNote}" />
        <meta-data android:name="gbarecomp.gyro" android:value="${gbaGyro}" />

        <!-- Not singleTask: relaunching a singleTask root from the launcher
             finishes the activities above it, so the suspended game was
             destroyed and the player landed on PLAY instead of the game. -->
        <activity
            android:name="com.ylports.mother3recomp.Mother3SetupActivity"
            android:alwaysRetainTaskState="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density"
            android:exported="true"
            android:launchMode="singleTop"
            android:preferMinimalPostProcessing="true"
            android:screenOrientation="${gbaActivityOrientation}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="org.gbarecomp.GbaGameActivity"
            android:alwaysRetainTaskState="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:preferMinimalPostProcessing="true"
            android:screenOrientation="${gbaActivityOrientation}" />
    </application>
</manifest>
