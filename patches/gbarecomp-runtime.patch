+bool GbaBus::dma_copy_ram(uint32_t src, uint32_t dst, uint32_t bytes) {
+    if (write_observer_ || !bytes) return false;
+    auto span = [&](uint32_t addr) -> std::pair<uint8_t*, std::size_t> {
+        if ((addr >> 24) == 2u) {
