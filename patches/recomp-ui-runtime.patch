+
+// ── Card menu (LauncherTheme::card_menu) ────────────────────────────────
+// The runtime menu dressed as the game's own front end: black ground, the
+// sections in one beige card with a white rim and a ▶ cursor, each setting a
+// beige card with a yellow outline when selected, yellow upper-case headings
+// and beige buttons with a white rim. Same model and input as the panel menu.
+
+const ImVec4 kInkOnBlack(1.0f, 1.0f, 1.0f, 1.0f);
+const ImVec4 kMutedOnBlack(0.59f, 0.59f, 0.59f, 1.0f);
+
+// A beige card with an optional outline (white rim, or yellow when focused).
+void card_rect(ImDrawList *draw, ImVec2 a, ImVec2 b, const LauncherTheme &theme,
+               const LngColor &fill, const LngColor *edge, float edge_w) {
+    draw->AddRectFilled(a, b, u32(fill), theme.radius_sm);
+    if (edge) draw->AddRect(a, b, u32(*edge), theme.radius_sm, 0, edge_w);
+}
+
+// A front-end button: beige with a white rim. Returns true when clicked.
+bool card_button(const char *id, const char *label, ImVec2 size,
+                 const LauncherTheme &theme, float rim) {
+    const ImVec2 at = ImGui::GetCursorScreenPos();
+    const bool clicked = ImGui::InvisibleButton(id, size);
+    const bool hot = ImGui::IsItemHovered() || ImGui::IsItemActive();
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const ImVec2 end(at.x + size.x, at.y + size.y);
+    card_rect(draw, at, end, theme, hot ? theme.panel_hovered : theme.background,
+              hot ? &theme.accent : &theme.border, rim);
+    const ImVec2 text = ImGui::CalcTextSize(label);
+    draw->AddText(ImVec2(at.x + (size.x - text.x) * 0.5f, at.y + (size.y - text.y) * 0.5f),
+                  u32(theme.text), label);
+    return clicked;
+}
+
+void upper(const char *in, char *out, size_t out_size) {
+    size_t n = 0;
+    for (; in && in[n] && n + 1 < out_size; ++n)
+        out[n] = (in[n] >= 'a' && in[n] <= 'z') ? static_cast<char>(in[n] - 32) : in[n];
+    out[n] = '\0';
+}
+
+void card_sections(RecompRuntimeUi *ui, const LauncherTheme &theme, float rim,
+                   bool enter_on_click) {
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const float pad = theme.spacing_md;
+    const float row_h = theme.row_height;
+    const ImVec2 origin = ImGui::GetCursorScreenPos();
+    const float width = ImGui::GetContentRegionAvail().x;
+    const float height = pad * 2.0f + row_h * static_cast<float>(ui->section_count);
+    card_rect(draw, origin, ImVec2(origin.x + width, origin.y + height), theme,
+              theme.background, &theme.border, rim);
+    const float line_h = ImGui::GetTextLineHeight();
+    const float cursor_w = line_h * 0.9f;
+    for (size_t index = 0; index < ui->section_count; ++index) {
+        ImGui::PushID(static_cast<int>(index));
+        const ImVec2 at(origin.x + pad * 0.5f, origin.y + pad + row_h * static_cast<float>(index));
+        ImGui::SetCursorScreenPos(at);
+        const bool clicked = ImGui::InvisibleButton("##section", ImVec2(width - pad, row_h));
+        const bool selected = index == ui->section_index;
+        if (selected && !ui->in_section)
+            draw->AddRectFilled(at, ImVec2(at.x + width - pad, at.y + row_h),
+                                u32(theme.panel_hovered), theme.radius_sm);
+        const float text_y = at.y + (row_h - line_h) * 0.5f;
+        if (selected) {
+            // The front end's ▶ cursor, drawn: the menu font has no such glyph.
+            const float x = at.x + pad * 0.5f, cy = at.y + row_h * 0.5f, h = line_h * 0.30f;
+            draw->AddTriangleFilled(ImVec2(x, cy - h), ImVec2(x, cy + h),
+                                    ImVec2(x + h * 1.6f, cy), u32(theme.text));
+        }
+        draw->AddText(ImVec2(at.x + pad * 0.5f + cursor_w, text_y), u32(theme.text),
+                      ui->sections[index]);
+        if ((clicked || ImGui::IsItemHovered()) &&
+            (index != ui->section_index || (clicked && enter_on_click))) {
+            const int was_in_section = ui->in_section;
+            recomp_runtime_ui_enter_section(ui, index);
+            if (!(clicked && enter_on_click)) ui->in_section = was_in_section;
+        }
+        ImGui::PopID();
+    }
+    ImGui::SetCursorScreenPos(ImVec2(origin.x, origin.y + height + theme.spacing_sm));
+}
+
+// A scrolled edge of the items page: a band holding an arrow, then a fade.
+float fade_band() { return ImGui::GetTextLineHeight() * 0.84f; }
+float fade_ramp(const LauncherTheme &theme) { return theme.row_height * 0.6f; }
+
+// A drag past the touch slop scrolls the page instead of picking a row.
+void card_items(RecompRuntimeUi *ui, const LauncherTheme &theme, bool touch_friendly,
+                float rim, bool dragged) {
+    static size_t s_last_row = static_cast<size_t>(-1);
+    static size_t s_last_section = static_cast<size_t>(-1);
+    const bool moved = ui->row_index != s_last_row || ui->section_index != s_last_section;
+    s_last_row = ui->row_index;
+    s_last_section = ui->section_index;
+
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const size_t count = recomp_runtime_ui_page_entry_count(ui);
+    for (size_t index = 0; index < count; ++index) {
+        char folder[96];
+        const RecompRuntimeUiItem *item = recomp_runtime_ui_page_entry(
+            ui, index, folder, sizeof(folder));
+        if (!item && !folder[0]) continue;
+        ImGui::PushID(static_cast<int>(index));
+        const bool selected = ui->in_section && index == ui->row_index;
+        const bool enabled = !item || recomp_runtime_ui_item_enabled(ui, item) != 0;
+        const bool has_description = item && item->description && item->description[0];
+        const float row_h = has_description
+            ? theme.row_height + ImGui::GetTextLineHeight() * 0.85f
+            : theme.row_height;
+        const float width = ImGui::GetContentRegionAvail().x;
+        const ImVec2 start = ImGui::GetCursorScreenPos();
+        const ImVec2 end(start.x + width, start.y + row_h);
+        const float step_w = touch_friendly ? std::max(76.0f, row_h * 0.80f) : 38.0f;
+        const float step_gap = touch_friendly ? 12.0f : 6.0f;
+        const bool stepped = item && item->type == RECOMP_RUNTIME_UI_INT && enabled;
+        const float step_controls_w = stepped ? step_w * 2.0f + step_gap + theme.spacing_sm : 0.0f;
+
+        if (item && (item->type == RECOMP_RUNTIME_UI_INT || item->type == RECOMP_RUNTIME_UI_TEXT))
+            ImGui::SetNextItemAllowOverlap();
+        if (!enabled) ImGui::BeginDisabled();
+        const bool clicked = ImGui::InvisibleButton("##row", ImVec2(width, row_h)) && !dragged;
+        if (ImGui::IsItemHovered() && !dragged) {
+            ui->row_index = index;
+            ui->in_section = 1;
+            s_last_row = index; // picked by the pointer, so already in view
+        }
+        if (selected && moved) {
+            // Centre a row only when it is cut off or under a fade.
+            const float top = ImGui::GetWindowPos().y;
+            const float bottom = top + ImGui::GetWindowHeight();
+            const float edge = fade_band() + fade_ramp(theme) * 0.5f;
+            if ((start.y < top + edge && ImGui::GetScrollY() > 0.5f) ||
+                (end.y > bottom - edge && ImGui::GetScrollY() < ImGui::GetScrollMaxY() - 0.5f))
+                ImGui::SetScrollHereY(0.5f);
+        }
+        card_rect(draw, start, end, theme, selected ? theme.panel_hovered : theme.background,
+                  selected ? &theme.accent : nullptr, rim);
+
+        const ImU32 ink = u32(enabled ? theme.text : theme.text_muted, enabled ? 1.0f : 0.65f);
+        const float pad = theme.spacing_md;
+        const float line_h = ImGui::GetTextLineHeight();
+        const float label_y = has_description
+            ? start.y + (row_h - line_h * 1.85f) * 0.5f
+            : start.y + (row_h - line_h) * 0.5f;
+        if (!item) {
+            draw->AddText(ImVec2(start.x + pad, label_y), ink, folder);
+            const ImVec2 arrow = ImGui::CalcTextSize(">");
+            draw->AddText(ImVec2(end.x - pad - arrow.x, label_y), ink, ">");
+            if (clicked) {
+                ui->row_index = index;
+                ui->in_section = 1;
+                if (recomp_runtime_ui_enter_folder(ui, index)) {
+                    if (!enabled) ImGui::EndDisabled();
+                    ImGui::PopID();
+                    return;
+                }
+            }
+        } else {
+            if (clicked) {
+                ui->row_index = index;
+                ui->in_section = 1;
+                if (item->type != RECOMP_RUNTIME_UI_INT)
+                    recomp_runtime_ui_adjust_current(ui, 1, 1, 0);
+            }
+            const bool editing_this = item->type == RECOMP_RUNTIME_UI_TEXT &&
+                                      ui->editing_text && selected;
+            char value[128] = "";
+            if (!editing_this) {
+                if (item->type == RECOMP_RUNTIME_UI_ACTION) {
+                    std::snprintf(value, sizeof(value), ">");
+                } else {
+                    char plain[112];
+                    value_text(ui, item, plain, sizeof(plain));
+                    const bool adjustable = item->type == RECOMP_RUNTIME_UI_CHOICE ||
+                                            item->type == RECOMP_RUNTIME_UI_BOOL ||
+                                            item->type == RECOMP_RUNTIME_UI_INT;
+                    if (selected && adjustable && enabled && !stepped)
+                        std::snprintf(value, sizeof(value), "<  %s  >", plain);
+                    else
+                        std::snprintf(value, sizeof(value), "%s", plain);
+                }
+                const ImVec2 size = ImGui::CalcTextSize(value);
+                draw->AddText(ImVec2(end.x - pad - size.x - step_controls_w,
+                                     start.y + (row_h - line_h) * 0.5f),
+                              ink, value);
+            }
+            // Label and description stop short of the value and its controls.
+            const float value_w = value[0] ? ImGui::CalcTextSize(value).x + pad : 0.0f;
+            const float text_right = std::max(start.x + pad * 2.0f,
+                                              end.x - pad - value_w - step_controls_w);
+            draw->PushClipRect(start, ImVec2(text_right, end.y), true);
+            draw->AddText(ImVec2(start.x + pad, label_y), ink, item->label ? item->label : "");
+            if (has_description)
+                draw->AddText(ImVec2(start.x + pad, label_y + line_h * 1.05f),
+                              u32(theme.text_muted), item->description);
+            draw->PopClipRect();
+            const ImVec2 next = ImGui::GetCursorScreenPos();
+            if (editing_this && enabled) {
+                const float field_w = touch_friendly
+                    ? std::clamp(width * 0.42f, 240.0f, 520.0f) : 200.0f;
+                const float field_h = touch_friendly
+                    ? std::max(ImGui::GetFrameHeight(), row_h * 0.72f) : ImGui::GetFrameHeight();
+                ImGui::SetCursorScreenPos(ImVec2(end.x - pad - field_w, start.y + (row_h - field_h) * 0.5f));
+                ImGui::SetNextItemWidth(field_w);
+                if (!ImGui::IsAnyItemActive()) ImGui::SetKeyboardFocusHere();
+                const bool submitted = ImGui::InputText(
+                    "##edit", ui->edit_buffer, sizeof(ui->edit_buffer),
+                    ImGuiInputTextFlags_EnterReturnsTrue | ImGuiInputTextFlags_AutoSelectAll);
+                if (submitted) {
+                    recomp_runtime_ui_commit_text(ui, item, ui->edit_buffer);
+                    ui->editing_text = 0;
+                } else if (ImGui::IsKeyPressed(ImGuiKey_Escape) ||
+                           (!ImGui::IsItemActive() && ImGui::IsAnyItemActive())) {
+                    ui->editing_text = 0;
+                }
+                ImGui::SetCursorScreenPos(next);
+            }
+            if (stepped) {
+                const float button_h = std::max(ImGui::GetFrameHeight(), row_h * 0.66f);
+                ImGui::SetCursorScreenPos(ImVec2(end.x - theme.spacing_sm - step_w * 2.0f - step_gap,
+                                                 start.y + (row_h - button_h) * 0.5f));
+                if (card_button("##minus", "-", ImVec2(step_w, button_h), theme, rim) && !dragged) {
+                    ui->row_index = index;
+                    ui->in_section = 1;
+                    recomp_runtime_ui_adjust_current(ui, -1, 1, 0);
+                }
+                ImGui::SameLine(0.0f, step_gap);
+                if (card_button("##plus", "+", ImVec2(step_w, button_h), theme, rim) && !dragged) {
+                    ui->row_index = index;
+                    ui->in_section = 1;
+                    recomp_runtime_ui_adjust_current(ui, 1, 1, 0);
+                }
+                ImGui::SetCursorScreenPos(next);
+            }
+        }
+        if (!enabled) ImGui::EndDisabled();
+        ImGui::SetCursorScreenPos(ImVec2(start.x, end.y + theme.spacing_sm));
+        ImGui::Dummy(ImVec2(0.0f, 0.0f));
+        ImGui::PopID();
+    }
+}
+
+// At an edge of the current window with more content beyond it, a small muted
+// arrow pointing that way in the band the content is clipped short of, and a
+// fade into the ground beside it.
+void scroll_fades(const LauncherTheme &theme, int ground_alpha) {
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const ImVec2 pos = ImGui::GetWindowPos();
+    const ImVec2 size = ImGui::GetWindowSize();
+    const float band = fade_band();
+    const float fade = fade_ramp(theme);
+    const float arrow = band / 3.0f;
+    const float left = pos.x, right = pos.x + size.x, mid = pos.x + size.x * 0.5f;
+    const ImU32 ground = IM_COL32(0, 0, 0, ground_alpha);
+    const ImU32 clear = IM_COL32(0, 0, 0, 0);
+    const ImU32 ink = u32(theme.background, 0.7f);
+    if (ImGui::GetScrollY() > 0.5f) {
+        const float top = pos.y + band;
+        draw->AddRectFilledMultiColor(ImVec2(left, top), ImVec2(right, top + fade),
+                                      ground, ground, clear, clear);
+        draw->AddTriangleFilled(ImVec2(mid - arrow * 1.6f, top - band * 0.5f + arrow * 0.8f),
+                                ImVec2(mid + arrow * 1.6f, top - band * 0.5f + arrow * 0.8f),
+                                ImVec2(mid, top - band * 0.5f - arrow * 0.8f), ink);
+    }
+    if (ImGui::GetScrollY() < ImGui::GetScrollMaxY() - 0.5f) {
+        const float bottom = pos.y + size.y - band;
+        draw->AddRectFilledMultiColor(ImVec2(left, bottom - fade), ImVec2(right, bottom),
+                                      clear, clear, ground, ground);
+        draw->AddTriangleFilled(ImVec2(mid - arrow * 1.6f, bottom + band * 0.5f - arrow * 0.8f),
+                                ImVec2(mid + arrow * 1.6f, bottom + band * 0.5f - arrow * 0.8f),
+                                ImVec2(mid, bottom + band * 0.5f + arrow * 0.8f), ink);
+    }
+}
