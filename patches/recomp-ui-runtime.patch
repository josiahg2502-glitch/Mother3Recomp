+void draw_card_menu(RecompRuntimeUi *ui, LauncherTheme theme, bool touch_friendly) {
+    ImGuiIO &io = ImGui::GetIO();
+    const ImVec2 display = io.DisplaySize;
+    const float short_axis = std::min(display.x, display.y);
+    const int ground_alpha =
+        static_cast<int>(255.0f * std::max(ui->dim, 0.92f) * ui->opacity + 0.5f);
+    ImGui::GetBackgroundDrawList()->AddRectFilled(ImVec2(0.0f, 0.0f), display,
+                                                  IM_COL32(0, 0, 0, ground_alpha));
+
+    if (touch_friendly) {
+        const float scale = std::clamp(short_axis * 0.085f, 92.0f, 124.0f) / theme.row_height;
+        theme.row_height *= scale;
+        theme.spacing_sm *= scale;
+        theme.spacing_md *= scale;
+        theme.spacing_lg *= scale;
+        theme.radius_sm *= scale;
+    }
+    const float rim = touch_friendly ? std::max(3.0f, short_axis * 0.0028f) : 2.0f;
+    const float margin = touch_friendly ? std::max(32.0f, short_axis * 0.045f) : 24.0f;
+    const float width = touch_friendly ? display.x - margin * 2.0f
+                                       : std::min(display.x - margin * 2.0f, 860.0f);
+    const float height = touch_friendly ? display.y - margin * 2.0f
