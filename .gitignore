# Commercial ROM and BIOS binaries (Never commit copyrighted dumps)
*.gba
*.GBA
*.bin
*.BIN
# ...except the CPU test-vector fixture, which is a build of the MIT-licensed
# singleStepTests/sm83 vectors (see pokemon-silver/tests/make_fixture.py) and
# is required for the SM83 suite to run without network access.
!pokemon-silver/tests/vectors.bin
gba_bios.bin
rom.cfg
bios.cfg

# Save files and savestates
saves/
*.sav
*.state*
*.log
*.raw

# Build directories & cache
build/
build-win/
gbarecomp/
recomp-ui/
generated/
recomp_cache/
release-stage/
*.zip
*.exe
*.dll
*.o
*.obj
*.def
*.bak*
_to_delete/

# Toolchain & Mods exceptions
!overlay_toolchain/**
!mods/**

# OS & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python bytecode (tooling under pokemon-silver/tools, tests, pc)
__pycache__/
*.pyc
